<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width m-carousel__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="meridian-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.handle != blank -%}
      <a href="{{ section.settings.profile_url | default: '#' }}" class="m-link" target="_blank" rel="noopener">{{ section.settings.handle | escape }}</a>
    {%- endif -%}
  </div>
  <ul class="m-carousel__track m-gallery" role="list" style="--m-per-row: {{ section.settings.columns_desktop }};">
    {%- for block in section.blocks -%}
      <li class="m-carousel__slide" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: section.settings.profile_url | default: '#' }}" class="m-gallery__item">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 18vw, 45vw', widths: '300, 450, 600, 800', alt: block.settings.image.alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.product != blank -%}
            <span class="m-gallery__tag">{{ block.settings.product.title | escape }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{% endstyle %}

{% schema %}
{
  "name": "Community gallery",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get inspired by our community" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@yourbrand" },
    { "type": "url", "id": "profile_url", "label": "Profile link" },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 8, "step": 0.5, "label": "Visible images on desktop", "default": 6 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "product", "id": "product", "label": "Tagged product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community gallery",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
