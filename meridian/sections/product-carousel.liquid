{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products_to_show = section.settings.products_to_show
  assign collection = section.settings.collection
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-carousel class="m-carousel section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
    <div class="page-width m-carousel__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="meridian-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="m-carousel__nav">
        {%- if section.settings.link_label != blank -%}
          <a href="{{ section.settings.link | default: collection.url }}" class="m-link">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
        <button type="button" class="m-carousel__arrow" data-dir="-1" aria-label="{{ 'general.slider.previous_slide' | t }}">
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </button>
        <button type="button" class="m-carousel__arrow m-carousel__arrow--next" data-dir="1" aria-label="{{ 'general.slider.next_slide' | t }}">
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </button>
      </div>
    </div>
    <ul class="m-carousel__track" role="list" style="--m-per-row: {{ section.settings.columns_desktop }};">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          <li class="m-carousel__slide">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: false,
              show_rating: false,
              section_id: section.id
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <li class="m-carousel__slide">{% render 'card-product', show_vendor: false %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </product-carousel>
</div>

{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
{% endstyle %}

<script src="{{ 'meridian.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fine jewelry made responsibly" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 24, "step": 1, "label": "Products to show", "default": 10 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 0.5, "label": "Visible cards on desktop", "default": 4.5, "info": "Use a half value to hint that the row scrolls." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the collection." },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "portrait",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ]
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show second image on hover", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "presets": [{ "name": "Product carousel" }]
}
{% endschema %}
