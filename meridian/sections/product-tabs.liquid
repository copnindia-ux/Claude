<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <m-tabs class="m-tabs">
      <div class="m-tabs__list" role="tablist">
        {%- for block in section.blocks -%}
          <button
            type="button"
            role="tab"
            id="Tab-{{ block.id }}"
            aria-controls="Panel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.title | escape }}
          </button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        <div class="m-tabs__panel rte" role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
          {%- if block.settings.use_description and product != blank -%}
            {{ product.description }}
          {%- else -%}
            {{ block.settings.content }}
            {{ block.settings.page.content }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </m-tabs>
  </div>
</div>

<script src="{{ 'meridian.js' | asset_url }}" defer="defer"></script>

{% style %}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  .section-{{ section.id }}-padding .m-tabs { max-width: {{ section.settings.max_width }}px; }
{% endstyle %}

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "range", "id": "max_width", "min": 400, "max": 1400, "step": 20, "unit": "px", "label": "Max width", "default": 640 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 12 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tab" },
        { "type": "checkbox", "id": "use_description", "label": "Show product description", "default": false },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Content from page" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [
        { "type": "tab", "settings": { "title": "Product overview", "use_description": true } },
        { "type": "tab", "settings": { "title": "Packaging", "content": "<p>Every piece arrives in a recycled-card gift box with a soft pouch and care card.</p>" } },
        { "type": "tab", "settings": { "title": "Shipping & returns", "content": "<p>Free shipping on orders over €300. Free returns within 30 days.</p>" } }
      ]
    }
  ]
}
{% endschema %}
