{%- if request.page_type == 'index' -%}<h1 class="site-header__logo">{%- else -%}<div class="site-header__logo">{%- endif -%}
  <a href="{{ routes.root_url }}">
    {%- if settings.logo != blank -%}
      {%- liquid
        assign logo_alt = settings.logo.alt | default: shop.name | escape
        assign logo_class = 'logo--default'
        if settings.logo_inverse != blank
          assign logo_class = 'logo--default has-inverse'
        endif
      -%}
      {{ settings.logo | image_url: width: 600 | image_tag: class: logo_class, widths: '150, 300, 450, 600', sizes: '(min-width: 990px) 200px, 120px', alt: logo_alt, loading: 'eager' }}
      {%- if settings.logo_inverse != blank -%}
        {{ settings.logo_inverse | image_url: width: 600 | image_tag: class: 'logo--inverse', widths: '150, 300, 450, 600', sizes: '(min-width: 990px) 200px, 120px', alt: logo_alt }}
      {%- endif -%}
    {%- else -%}
      <span>{{ shop.name | escape }}</span>
    {%- endif -%}
  </a>
{%- if request.page_type == 'index' -%}</h1>{%- else -%}</div>{%- endif -%}
