{%- comment -%}
  - form: customer_address form
  - id: unique suffix
{%- endcomment -%}
{%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
<div class="grid">
  <div class="field"><label for="AddressFirstName-{{ id }}">{{ 'customer.addresses.first_name' | t }}</label><input class="input" id="AddressFirstName-{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
  <div class="field"><label for="AddressLastName-{{ id }}">{{ 'customer.addresses.last_name' | t }}</label><input class="input" id="AddressLastName-{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
  <div class="field"><label for="AddressCompany-{{ id }}">{{ 'customer.addresses.company' | t }}</label><input class="input" id="AddressCompany-{{ id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization"></div>
  <div class="field"><label for="AddressPhone-{{ id }}">{{ 'customer.addresses.phone' | t }}</label><input class="input" type="tel" id="AddressPhone-{{ id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
  <div class="field"><label for="AddressAddress1-{{ id }}">{{ 'customer.addresses.address1' | t }}</label><input class="input" id="AddressAddress1-{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
  <div class="field"><label for="AddressAddress2-{{ id }}">{{ 'customer.addresses.address2' | t }}</label><input class="input" id="AddressAddress2-{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
  <div class="field"><label for="AddressCity-{{ id }}">{{ 'customer.addresses.city' | t }}</label><input class="input" id="AddressCity-{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
  <div class="field"><label for="AddressZip-{{ id }}">{{ 'customer.addresses.zip' | t }}</label><input class="input" id="AddressZip-{{ id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" autocapitalize="characters"></div>
  <div class="field">
    <label for="AddressCountry-{{ id }}">{{ 'customer.addresses.country' | t }}</label>
    <div class="select-wrapper">
      <select class="select" id="AddressCountry-{{ id }}" name="address[country]" data-country-select data-province-wrap="AddressProvinceWrap-{{ id }}" data-default="{{ form.country }}" autocomplete="country">
        {{ all_country_option_tags }}
      </select>
      {%- render 'icon', icon: 'caret' -%}
    </div>
  </div>
  <div class="field" id="AddressProvinceWrap-{{ id }}" hidden>
    <label for="AddressProvince-{{ id }}">{{ 'customer.addresses.province' | t }}</label>
    <div class="select-wrapper">
      <select class="select" id="AddressProvince-{{ id }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
      {%- render 'icon', icon: 'caret' -%}
    </div>
  </div>
</div>
<label class="checkbox" style="margin-bottom:1.6rem">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>
