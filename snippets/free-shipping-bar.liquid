{%- comment -%}
  Free shipping progress. The threshold is entered in the store's default currency.
{%- endcomment -%}
{%- if settings.cart_free_shipping_enabled and settings.cart_free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.cart_free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100
  -%}
  <div class="free-shipping" data-free-shipping>
    {%- if remaining > 0 -%}
      {%- assign remaining_money = remaining | money -%}
      {{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_money }}
    {%- else -%}
      {{ 'sections.cart.free_shipping_unlocked' | t }}
    {%- endif -%}
    <div class="free-shipping__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent | round }}">
      <span style="width: {{ percent }}%"></span>
    </div>
  </div>
{%- endif -%}
