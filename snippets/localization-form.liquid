{%- comment -%}
  Country / language selectors.
  - id: unique form id
  - show_country, show_language: default true
{%- endcomment -%}
{%- liquid
  assign show_c = true
  assign show_l = true
  if show_country == false
    assign show_c = false
  endif
  if show_language == false
    assign show_l = false
  endif
-%}
{%- if localization.available_countries.size > 1 and show_c or localization.available_languages.size > 1 and show_l -%}
  {%- form 'localization', id: id, class: 'localization-form', data-localization-form: '' -%}
    {%- if localization.available_countries.size > 1 and show_c -%}
      <div class="select-wrapper">
        <label class="visually-hidden" for="{{ id }}-country">{{ 'localization.country_label' | t }}</label>
        <select class="select" id="{{ id }}-country" name="country_code" data-autosubmit>
          {%- for country in localization.available_countries -%}
            <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
              {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
            </option>
          {%- endfor -%}
        </select>
        {%- render 'icon', icon: 'caret' -%}
      </div>
    {%- endif -%}
    {%- if localization.available_languages.size > 1 and show_l -%}
      <div class="select-wrapper">
        <label class="visually-hidden" for="{{ id }}-language">{{ 'localization.language_label' | t }}</label>
        <select class="select" id="{{ id }}-language" name="language_code" data-autosubmit>
          {%- for language in localization.available_languages -%}
            <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
              {{- language.endonym_name | capitalize -}}
            </option>
          {%- endfor -%}
        </select>
        {%- render 'icon', icon: 'caret' -%}
      </div>
    {%- endif -%}
    <noscript><button class="button button--small">{{ 'localization.update' | t }}</button></noscript>
  {%- endform -%}
{%- endif -%}
