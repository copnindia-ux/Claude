{%- comment -%}
  Star rating.
  - rating: rating value object (rating.value / rating.scale_max) or number
  - count: optional review count
{%- endcomment -%}
{%- liquid
  assign rating_value = rating.rating | default: rating | times: 1.0
  assign scale_max = rating.scale_max | default: 5
  assign rounded = rating_value | round
-%}
<div class="card__rating product__rating">
  <span class="testimonial__stars" aria-hidden="true">
    {%- for i in (1..scale_max) -%}
      {%- if i <= rounded -%}{% render 'icon', icon: 'star' %}{%- else -%}{% render 'icon', icon: 'star-empty' %}{%- endif -%}
    {%- endfor -%}
  </span>
  <span class="visually-hidden">{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: scale_max }}</span>
  {%- if count -%}<span class="subtext">({{ count }})</span>{%- endif -%}
</div>
