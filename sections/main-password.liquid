{%- assign s = section.settings -%}
<section class="password-page color-{{ s.color_scheme }}" style="position:relative">
  {%- if s.image != blank -%}
    <div class="banner__media" style="--overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};">
      {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800, 1200, 1800, 2400', sizes: '100vw', alt: '' }}
    </div>
  {%- endif -%}
  <div style="position:relative;z-index:2;display:flex;flex-direction:column;gap:2.4rem;align-items:center;max-width:52rem;{% if s.image != blank and s.text_light %}color:#fff;{% endif %}">
    <div class="site-header__logo">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = shop.name | escape -%}
        {{ settings.logo | image_url: width: 400 | image_tag: style: 'width: 160px', alt: logo_alt }}
      {%- else -%}
        <span class="h2">{{ shop.name | escape }}</span>
      {%- endif -%}
    </div>
    {%- if s.heading != blank -%}<h1 class="h0" style="margin:0">{{ s.heading }}</h1>{%- endif -%}
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

    <div style="width:100%;background:rgb(var(--color-background));color:rgb(var(--color-foreground));padding:2.4rem;border-radius:var(--card-radius)">
      {%- render 'newsletter-form', id: 'PasswordNewsletter', form_id: section.id, button_style: 'button' -%}
    </div>

    <details>
      <summary class="link-underline caption" style="cursor:pointer;list-style:none">{{ 'general.password_page.login_password_button' | t }}</summary>
      {%- form 'storefront_password', class: 'inline-form', style: 'margin-top:1.6rem' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors.messages['form'] }}</div>{%- endif -%}
        <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <input class="input" type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" style="background:rgb(var(--color-background))">
        <button class="button" name="commit">{{ 'general.password_page.login_form_submit' | t }}</button>
      {%- endform -%}
    </details>
    <p class="caption subtext">{{ 'general.password_page.admin_link_html' | t }} &middot; {{ powered_by_link }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 20 },
    { "type": "checkbox", "id": "text_light", "label": "Light text over image", "default": true },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "coming soon" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
