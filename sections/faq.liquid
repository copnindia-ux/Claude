{%- assign s = section.settings -%}
<section class="color-{{ s.color_scheme }} section-padding" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
  <div class="page-width{% if s.layout == 'stacked' %} page-width--narrow{% endif %}">
    <div style="display:grid;gap:3.2rem;{% if s.layout == 'split' %}grid-template-columns:repeat(auto-fit,minmax(min(100%,36rem),1fr));{% endif %}">
      <div>
        {%- if s.heading != blank -%}<h2 class="h1" style="{% if s.layout == 'stacked' %}text-align:center;{% endif %}">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte subtext" style="{% if s.layout == 'stacked' %}text-align:center;{% endif %}">{{ s.text }}</div>{%- endif -%}
      </div>
      <div>
        {%- for block in section.blocks -%}
          <details class="accordion" {% if s.open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span class="accordion__title">{{ block.settings.heading | escape }}</span>
              {%- render 'icon', icon: 'plus' -%}
            </summary>
            <div class="accordion__content rte">
              {{ block.settings.content }}
              {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if s.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.heading | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.content | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ / collapsible content",
  "max_blocks": 30,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "questions" },
    { "type": "richtext", "id": "text", "label": "Description" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "stacked", "label": "Stacked" }, { "value": "split", "label": "Heading beside questions" } ], "default": "split" },
    { "type": "checkbox", "id": "open_first", "label": "Open first item", "default": false },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data (SEO)", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "heading", "label": "Question", "default": "is it suitable for sensitive skin?" },
        { "type": "richtext", "id": "content", "label": "Answer", "default": "<p>Add a clear, helpful answer here.</p>" },
        { "type": "page", "id": "page", "label": "Additional content from page" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "heading": "how long does shipping take?" } },
        { "type": "question", "settings": { "heading": "what is your return policy?" } }
      ]
    }
  ]
}
{% endschema %}
