{%- liquid
  assign s = section.settings
-%}
<section class="illus-categories illus-categories--{{ s.style }} color-{{ s.color_scheme }} section-padding" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">
    {%- if s.heading != blank -%}
      <div class="section-header{% if s.heading_align == 'center' %} section-header--center{% endif %}">
        <h2 class="section-header__title {{ s.heading_size }}">{{ s.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <ul class="illus-categories__list list-unstyled{% if s.heading_align == 'center' %} is-centered{% endif %}" role="list" style="--tile-cols: {{ s.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign t_url = block.settings.link
          assign t_title = block.settings.title
          if block.settings.collection != blank
            assign t_url = t_url | default: block.settings.collection.url
            assign t_title = t_title | default: block.settings.collection.title
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          {%- render 'menu-tile', title: t_title, url: t_url, image: block.settings.image, art: block.settings.illustration, size: 'lg' -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Illustrated categories",
  "class": "section-illus-categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "shop by category" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h3", "label": "Small" }, { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" } ], "default": "h2" },
    { "type": "select", "id": "heading_align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "select", "id": "style", "label": "Tile style", "options": [ { "value": "circle", "label": "Circles" }, { "value": "card", "label": "Cards" } ], "default": "card" },
    { "type": "range", "id": "columns_desktop", "min": 4, "max": 10, "step": 1, "label": "Tiles per row on desktop", "default": 8 },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 24 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "limit": 16,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the collection." },
        {
          "type": "select",
          "id": "illustration",
          "label": "Illustration",
          "options": [
            { "value": "serum", "label": "Serum" },
            { "value": "cream", "label": "Moisturizer" },
            { "value": "cleanser", "label": "Cleanser" },
            { "value": "sunscreen", "label": "Sunscreen" },
            { "value": "toner", "label": "Toner" },
            { "value": "mask", "label": "Mask" },
            { "value": "eye", "label": "Eye care" },
            { "value": "lip", "label": "Lip care" },
            { "value": "body", "label": "Body" },
            { "value": "tools", "label": "Tools" },
            { "value": "sets", "label": "Sets & gifts" },
            { "value": "new", "label": "New" },
            { "value": "bestsellers", "label": "Bestsellers" },
            { "value": "face", "label": "Face" },
            { "value": "drop", "label": "Hydration" },
            { "value": "leaf", "label": "Clean" },
            { "value": "sun", "label": "Morning" },
            { "value": "moon", "label": "Night" }
          ],
          "default": "serum"
        },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Replaces the illustration." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Illustrated categories",
      "blocks": [
        { "type": "tile", "settings": { "title": "cleansers", "illustration": "cleanser" } },
        { "type": "tile", "settings": { "title": "toners", "illustration": "toner" } },
        { "type": "tile", "settings": { "title": "serums", "illustration": "serum" } },
        { "type": "tile", "settings": { "title": "moisturizers", "illustration": "cream" } },
        { "type": "tile", "settings": { "title": "spf", "illustration": "sunscreen" } },
        { "type": "tile", "settings": { "title": "masks", "illustration": "mask" } },
        { "type": "tile", "settings": { "title": "eyes", "illustration": "eye" } },
        { "type": "tile", "settings": { "title": "lips", "illustration": "lip" } }
      ]
    }
  ]
}
{% endschema %}
