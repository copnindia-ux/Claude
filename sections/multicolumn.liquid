{%- liquid
  assign s = section.settings
  case s.image_ratio
    when 'square'
      assign ratio = '100%'
    when 'landscape'
      assign ratio = '66.66%'
    when 'circle'
      assign ratio = '100%'
    else
      assign ratio = '125%'
  endcase
-%}
<section class="color-{{ s.color_scheme }} section-padding" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">
    {%- render 'section-heading', heading: s.heading, text: s.text, align: s.heading_align, link_label: s.link_label, link_url: s.link_url -%}
    <div class="grid" style="--cols-desktop: {{ s.columns_desktop }}; --cols-tablet: {{ s.columns_desktop | at_most: 2 }}; --cols-mobile: {{ s.columns_mobile }}; --ratio: {{ ratio }}; --icon-size: {{ s.icon_size }}px;">
      {%- for block in section.blocks -%}
        <div class="multicolumn__item{% if s.text_align == 'center' %} multicolumn__item--center{% endif %}{% if s.show_card %} has-card{% endif %}{% if settings.animations_enabled %} reveal{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- if s.image_style == 'icon' -%}
              {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'multicolumn__icon', alt: block.settings.image.alt }}
            {%- else -%}
              <div class="media"{% if s.image_ratio == 'circle' %} style="border-radius:50%"{% endif %}>
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 600, 900, 1200', sizes: '(min-width: 990px) 33vw, 100vw', alt: block.settings.image.alt }}
              </div>
            {%- endif -%}
          {%- elsif block.settings.icon != 'none' -%}
            <span style="display:inline-flex;width:var(--icon-size);height:var(--icon-size)">{%- render 'icon', icon: block.settings.icon -%}</span>
            <style>#shopify-section-{{ section.id }} .multicolumn__item .icon { width: 100%; height: 100%; }</style>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="h4" style="margin:0">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="rte subtext">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<a href="{{ block.settings.link | default: '#' }}" class="link-underline">{{ block.settings.link_label | escape }}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "max_blocks": 12,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "why you'll love it" },
    { "type": "richtext", "id": "text", "label": "Description" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "text", "id": "link_label", "label": "Header link label" },
    { "type": "url", "id": "link_url", "label": "Header link" },
    { "type": "select", "id": "image_style", "label": "Image style", "options": [ { "value": "image", "label": "Full image" }, { "value": "icon", "label": "Small icon" } ], "default": "image" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape" }, { "value": "circle", "label": "Circle" } ], "default": "portrait" },
    { "type": "range", "id": "icon_size", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Icon size", "default": 36 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "checkbox", "id": "show_card", "label": "Show card background", "default": false },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 6, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ], "default": "2" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "icon", "label": "Icon (if no image)", "options": [ { "value": "none", "label": "None" }, { "value": "drop", "label": "Drop" }, { "value": "leaf", "label": "Leaf" }, { "value": "rabbit", "label": "Cruelty free" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }, { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "lock", "label": "Lock" }, { "value": "gift", "label": "Gift" }, { "value": "check", "label": "Check" } ], "default": "sparkle" },
        { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "column" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pair text with an image or icon to highlight a benefit.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "icon": "drop", "title": "hydrating" } },
        { "type": "column", "settings": { "icon": "leaf", "title": "clean formulas" } },
        { "type": "column", "settings": { "icon": "rabbit", "title": "cruelty free" } },
        { "type": "column", "settings": { "icon": "sparkle", "title": "everyday glow" } }
      ]
    }
  ]
}
{% endschema %}
