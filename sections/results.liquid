{%- liquid
  assign s = section.settings
  assign stats = section.blocks | where: 'type', 'stat'
  assign steps = section.blocks | where: 'type', 'timeline_step'
  assign has_media = false
  if s.layout == 'split'
    assign has_media = true
  endif
-%}
{{ 'section-results.css' | asset_url | stylesheet_tag }}

<section
  class="results color-{{ s.color_scheme }} section-padding results--{{ s.layout }}"
  style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};"
>
  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">
    <div class="results__layout">
      {%- if has_media -%}
        <div class="results__media{% if settings.animations_enabled %} reveal{% endif %}">
          <div class="media" style="padding-top: {{ s.media_ratio }}%;">
            {%- if s.image != blank -%}
              {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400, 1600', sizes: '(min-width: 990px) 45vw, 100vw', alt: s.image.alt }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if s.media_badge != blank -%}
            <span class="results__badge">{%- render 'icon', icon: 'flask' -%}{{ s.media_badge | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="results__content">
        <div class="results__intro{% if settings.animations_enabled %} reveal{% endif %}">
          {%- if s.caption != blank -%}<p class="caption results__caption">{{ s.caption | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="{{ s.heading_size }} results__heading">{{ s.heading | escape }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<div class="rte subtext">{{ s.text }}</div>{%- endif -%}
        </div>

        {%- if stats.size > 0 -%}
          <ul class="results__stats list-unstyled" role="list" style="--stat-cols: {{ s.stat_columns }};">
            {%- for block in stats -%}
              {%- assign pct = block.settings.value | at_most: 100 -%}
              <li class="result-stat result-stat--{{ block.settings.display }}{% if settings.animations_enabled %} reveal{% endif %}" style="--progress: {{ pct }}; --i: {{ forloop.index0 }};" data-count-up {{ block.shopify_attributes }}>
                {%- if block.settings.display == 'ring' -%}
                  <span class="result-stat__ring" aria-hidden="true">
                    <svg viewBox="0 0 120 120"><circle class="result-stat__track" cx="60" cy="60" r="54"/><circle class="result-stat__bar" cx="60" cy="60" r="54" pathLength="100"/></svg>
                    <span class="result-stat__value h2">{{ block.settings.prefix }}<span data-count-to="{{ block.settings.value }}">{{ block.settings.value }}</span>{{ block.settings.suffix }}</span>
                  </span>
                {%- else -%}
                  <span class="result-stat__value h0">{{ block.settings.prefix }}<span data-count-to="{{ block.settings.value }}">{{ block.settings.value }}</span>{{ block.settings.suffix }}</span>
                  {%- if block.settings.display == 'bar' -%}
                    <span class="result-stat__meter" aria-hidden="true"><span></span></span>
                  {%- endif -%}
                {%- endif -%}
                <span class="result-stat__label">{{ block.settings.label | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if steps.size > 0 -%}
          <div class="results__timeline">
            {%- if s.timeline_heading != blank -%}<p class="caption subtext">{{ s.timeline_heading | escape }}</p>{%- endif -%}
            <ol class="results__steps list-unstyled" role="list">
              {%- for block in steps -%}
                <li class="results__step{% if settings.animations_enabled %} reveal{% endif %}" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
                  <div class="media" style="padding-top: 125%;">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '(min-width: 990px) 15vw, 40vw', alt: block.settings.image.alt }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    <span class="results__step-label">{{ block.settings.label | escape }}</span>
                  </div>
                  {%- if block.settings.caption != blank -%}<p class="caption subtext">{{ block.settings.caption | escape }}</p>{%- endif -%}
                </li>
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}

        {%- if s.button_label != blank or s.footnote != blank -%}
          <div class="results__footer">
            {%- if s.button_label != blank -%}
              <a href="{{ s.button_link }}" class="button">{{ s.button_label | escape }}</a>
            {%- endif -%}
            {%- if s.footnote != blank -%}<p class="results__footnote">{{ s.footnote | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Results",
  "class": "section-results",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "split", "label": "Image and results" }, { "value": "centered", "label": "Results only" } ], "default": "split" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "clinically proven" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "real results in 4 weeks" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" } ], "default": "h1" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We tested our hero serum with 112 people across every skin type. Here's what they saw.</p>" },
    { "type": "range", "id": "stat_columns", "min": 1, "max": 4, "step": 1, "label": "Results per row on desktop", "default": 2 },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "media_ratio", "label": "Image shape", "options": [ { "value": "100", "label": "Square" }, { "value": "125", "label": "Portrait" }, { "value": "150", "label": "Tall" } ], "default": "125" },
    { "type": "text", "id": "media_badge", "label": "Image badge", "default": "dermatologist tested" },
    { "type": "header", "content": "Progress timeline" },
    { "type": "text", "id": "timeline_heading", "label": "Timeline heading", "default": "the 8-week journey" },
    { "type": "header", "content": "Footer" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "shop the serum" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "*Independent consumer study, 112 participants, after 4 weeks of twice-daily use." },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Result",
      "limit": 8,
      "settings": [
        { "type": "range", "id": "value", "min": 0, "max": 100, "step": 1, "label": "Number", "default": 93 },
        { "type": "text", "id": "prefix", "label": "Before number" },
        { "type": "text", "id": "suffix", "label": "After number", "default": "%" },
        { "type": "text", "id": "label", "label": "Label", "default": "saw brighter, more even skin" },
        { "type": "select", "id": "display", "label": "Display", "options": [ { "value": "ring", "label": "Ring" }, { "value": "bar", "label": "Bar" }, { "value": "number", "label": "Number only" } ], "default": "ring", "info": "Rings and bars fill to the number as a percentage." }
      ]
    },
    {
      "type": "timeline_step",
      "name": "Timeline photo",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "week 0" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results",
      "blocks": [
        { "type": "stat", "settings": { "value": 93, "label": "saw brighter, more even skin" } },
        { "type": "stat", "settings": { "value": 88, "label": "said skin felt plumper" } },
        { "type": "stat", "settings": { "value": 97, "label": "had more hydrated skin" } },
        { "type": "stat", "settings": { "value": 81, "label": "noticed smaller-looking pores" } }
      ]
    }
  ]
}
{% endschema %}
