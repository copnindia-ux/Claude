{%- assign s = section.settings -%}
<section class="color-{{ s.color_scheme }} section-padding" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
  <div class="page-width">
    {%- render 'section-heading', heading: s.heading, link_label: s.link_label, link_url: s.blog.url -%}
    <div class="grid" style="--cols-desktop: {{ s.columns_desktop }}; --cols-tablet: 2; --cols-mobile: 1;">
      {%- if s.blog != blank and s.blog.articles_count > 0 -%}
        {%- for article in s.blog.articles limit: s.post_limit -%}
          {%- render 'article-card', article: article, show_image: s.show_image, show_date: s.show_date, show_author: s.show_author, show_excerpt: s.show_excerpt -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="article-card">
            <div class="media" style="--ratio:75%">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <h3 class="article-card__title">{{ 'onboarding.blog_title' | t }}</h3>
            <p class="article-card__excerpt">{{ 'onboarding.blog_excerpt' | t }}</p>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "the journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "read all" },
    { "type": "range", "id": "post_limit", "min": 2, "max": 6, "step": 1, "label": "Number of posts", "default": 3 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 3 },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "presets": [ { "name": "Blog posts" } ]
}
{% endschema %}
