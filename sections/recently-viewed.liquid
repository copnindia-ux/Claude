{%- liquid
  assign s = section.settings
-%}
<product-list-loader
  class="recently-viewed color-{{ s.color_scheme }} section-padding"
  style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};"
  data-source="recent"
  data-limit="{{ s.limit }}"
  {% if product %}data-exclude="{{ product.handle }}"{% endif %}
  data-hide-empty
  hidden
>
  <slider-component class="page-width{% if s.full_width %} page-width--full{% endif %}">
    <div class="section-header">
      <h2 class="section-header__title {{ s.heading_size }}">{{ s.heading | escape }}</h2>
      <div class="slider-buttons small-hide">
        <button type="button" class="icon-button slider-button" data-slider-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{%- render 'icon', icon: 'chevron-left' -%}</button>
        <button type="button" class="icon-button slider-button" data-slider-next aria-label="{{ 'accessibility.next_slide' | t }}">{%- render 'icon', icon: 'chevron-right' -%}</button>
      </div>
    </div>
    <div class="slider" data-slider data-list-grid style="--per-view: {{ s.columns_desktop }}; --per-view-mobile: 2.2;"></div>
  </slider-component>
</product-list-loader>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "paragraph", "content": "Shows products the shopper has viewed, stored in their browser. Hidden until there is something to show." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "recently viewed" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h3", "label": "Small" }, { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" } ], "default": "h2" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Max products", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 6, "step": 1, "label": "Products per row on desktop", "default": 4 },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "presets": [ { "name": "Recently viewed" } ]
}
{% endschema %}
