{%- comment -%}Used only by the Section Rendering API to refresh the header cart count.{%- endcomment -%}
<span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>
  {%- if cart.item_count < 100 -%}{{ cart.item_count }}{%- else -%}99+{%- endif -%}
</span>
<span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
