{%- liquid
  assign s = section.settings
  assign has_filters = false
  if search.performed and search.filters.size > 0 and s.enable_filtering
    assign has_filters = true
  endif
-%}
<section class="color-{{ s.color_scheme }} section-padding" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
  <facet-filters class="page-width page-width--full" data-section="{{ section.id }}">
    <div class="page-width--narrow" style="margin:0 auto 3.2rem;text-align:center">
      <h1 class="h1">{{ 'templates.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="inline-form">
        <label class="visually-hidden" for="SearchPage-input">{{ 'general.search.search' | t }}</label>
        <input id="SearchPage-input" class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button class="button" type="submit">{{ 'general.search.submit' | t }}</button>
      </form>
      {%- if search.performed -%}
        <p class="subtext" style="margin-top:1.6rem" data-product-count>{{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}</p>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- paginate search.results by s.per_page -%}
        <div class="facets-toolbar">
          <div class="facets-toolbar__left">
            {%- if has_filters -%}
              <button type="button" class="icon-button" data-drawer-open="FacetsDrawer" aria-controls="FacetsDrawer">{%- render 'icon', icon: 'filter' -%} {{ 'products.facets.filter' | t }}</button>
            {%- endif -%}
          </div>
          <div class="facets-toolbar__right">
            <div class="select-wrapper">
              <label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'products.facets.sort_by' | t }}</label>
              <select class="select" id="SortBy-{{ section.id }}" name="sort_by" data-sort>
                {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                {%- for option in search.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
              </select>
              {%- render 'icon', icon: 'caret' -%}
            </div>
          </div>
        </div>
        <div id="ActiveFacets-{{ section.id }}" data-active-facets-container>
          {%- assign encoded_terms = search.terms | url_encode -%}
          {%- assign search_clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last' -%}
          {%- render 'active-facets', results: search, clear_url: search_clear_url -%}
        </div>
        <div id="ProductGrid-{{ section.id }}" data-product-grid-container>
          {%- if search.results_count == 0 -%}
            <div class="grid-empty"><p class="h3">{{ 'templates.search.no_results' | t: terms: search.terms }}</p></div>
          {%- else -%}
            <div class="grid product-grid" data-product-grid style="--cols-desktop: {{ s.columns_desktop }}; --cols-tablet: 3; --cols-mobile: 2;">
              {%- for item in search.results -%}
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {%- render 'product-card', product: item -%}
                  {%- when 'article' -%}
                    {%- render 'article-card', article: item, show_excerpt: false -%}
                  {%- when 'page' -%}
                    <a href="{{ item.url }}" class="card" style="padding:2.4rem;background:rgb(var(--color-card));border-radius:var(--card-radius);justify-content:flex-end;min-height:24rem">
                      <span class="caption subtext">{{ 'templates.search.page' | t }}</span>
                      <span class="h4" style="margin:0">{{ item.title | escape }}</span>
                    </a>
                {%- endcase -%}
              {%- endfor -%}
            </div>
            {%- render 'pagination', paginate: paginate -%}
          {%- endif -%}
        </div>
        {%- if has_filters -%}
          <facets-drawer class="drawer drawer--left" id="FacetsDrawer" aria-hidden="true">
            <div class="drawer__overlay" data-close></div>
            <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'products.facets.filter' | t }}" tabindex="-1">
              <div class="drawer__header">
                <h2 class="drawer__title">{{ 'products.facets.filter' | t }}</h2>
                <button type="button" class="icon-button" data-close aria-label="{{ 'accessibility.close' | t }}">{%- render 'icon', icon: 'close' -%}</button>
              </div>
              <div class="drawer__body" id="FacetsDrawerBody-{{ section.id }}" data-facets-container>
                {%- render 'facets', results: search, id_prefix: 'Drawer', section_id: section.id -%}
              </div>
              <div class="drawer__footer"><button type="button" class="button button--full" data-close>{{ 'products.facets.view_results' | t }}</button></div>
            </div>
          </facets-drawer>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </facet-filters>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Results per page", "default": 24 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ]
}
{% endschema %}
