{%- liquid
  assign s = section.settings
  case s.image_ratio
    when 'square'
      assign ratio = '100%'
    when 'story'
      assign ratio = '177.7%'
    else
      assign ratio = '125%'
  endcase
-%}
<section class="color-{{ s.color_scheme }} section-padding" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
  <slider-component class="page-width{% if s.full_width %} page-width--full{% endif %}">
    {%- render 'section-heading', heading: s.heading, text: s.text, align: s.heading_align, link_label: s.link_label, link_url: s.link_url, slider: s.carousel -%}
    <div class="{% if s.carousel %}slider{% else %}ugc-grid{% endif %}" data-slider style="--cols-desktop: {{ s.columns_desktop }}; --cols-mobile: 2; --per-view: {{ s.columns_desktop }}; --per-view-mobile: 1.6; --ratio: {{ ratio }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="ugc-item" {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}<a href="{{ b.link }}" style="position:absolute;inset:0;z-index:1" aria-label="{{ b.caption | default: 'View post' | escape }}"></a>{%- endif -%}
          <div class="media">
            {%- if b.video != blank -%}
              {{ b.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '600x' }}
            {%- elsif b.image != blank -%}
              {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 500, 700, 900', sizes: '(min-width: 990px) 20vw, 50vw', alt: b.image.alt | escape }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 2 | plus: 1 -%}
              {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if b.product != blank -%}
            <a href="{{ b.product.url }}" class="ugc-item__product">
              <span class="media">{%- if b.product.featured_media -%}{{ b.product.featured_media | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
              <span style="flex:1;min-width:0">
                <span style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ b.product.title | escape }}</span>
                <span class="subtext">{{ b.product.price | money }}</span>
              </span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </slider-component>
</section>

{% schema %}
{
  "name": "Shoppable gallery",
  "max_blocks": 20,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "as seen on you" },
    { "type": "richtext", "id": "text", "label": "Description" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "follow us" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "checkbox", "id": "carousel", "label": "Show as carousel", "default": true },
    { "type": "select", "id": "image_ratio", "label": "Media ratio", "options": [ { "value": "portrait", "label": "Portrait 4:5" }, { "value": "square", "label": "Square" }, { "value": "story", "label": "Story 9:16" } ], "default": "story" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Columns (desktop)", "default": 5 },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "caption", "label": "Accessible caption" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "product", "id": "product", "label": "Tagged product" }
      ]
    }
  ],
  "presets": [ { "name": "Shoppable gallery", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
