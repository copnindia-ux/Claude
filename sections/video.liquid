{%- assign s = section.settings -%}
<section class="color-{{ s.color_scheme }}{% unless s.full_width %} section-padding{% endunless %}" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
  <div class="{% if s.full_width %}page-width--full{% else %}page-width{% endif %}">
    {%- unless s.full_width -%}
      {%- render 'section-heading', heading: s.heading, align: 'center' -%}
    {%- endunless -%}
    <video-player class="video-wrapper media" style="padding-top: {{ s.ratio }}; border-radius: {% if s.full_width %}0{% else %}var(--media-radius){% endif %};">
      {%- if s.video != blank -%}
        {%- if s.autoplay -%}
          {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1920x' }}
        {%- else -%}
          <template>{{ s.video | video_tag: autoplay: true, loop: false, muted: false, playsinline: true, controls: true, image_size: '1920x' }}</template>
          <button type="button" class="video-poster" data-play aria-label="{{ 'sections.video.load_video' | t: description: s.description | escape }}">
            {%- if s.cover_image != blank -%}
              {{ s.cover_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1800, 2400', sizes: '100vw', alt: '', style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover' }}
            {%- else -%}
              {{ s.video.preview_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1800, 2400', sizes: '100vw', alt: '', style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover' }}
            {%- endif -%}
            <span class="video-poster__play">{%- render 'icon', icon: 'play' -%}</span>
          </button>
        {%- endif -%}
      {%- elsif s.video_url != blank -%}
        <template>
          {%- if s.video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ s.video_url.id }}?autoplay=1&rel=0" allow="autoplay; encrypted-media" allowfullscreen title="{{ s.description | escape }}"></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ s.video_url.id }}?autoplay=1" allow="autoplay; fullscreen" allowfullscreen title="{{ s.description | escape }}"></iframe>
          {%- endif -%}
        </template>
        <button type="button" class="video-poster" data-play aria-label="{{ 'sections.video.load_video' | t: description: s.description | escape }}">
          {%- if s.cover_image != blank -%}
            {{ s.cover_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1800, 2400', sizes: '100vw', alt: '', style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover' }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="video-poster__play">{%- render 'icon', icon: 'play' -%}</span>
        </button>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </video-player>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "Or YouTube / Vimeo URL" },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
    { "type": "text", "id": "description", "label": "Video alt text", "default": "Brand video" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay muted loop (Shopify-hosted only)", "default": true },
    { "type": "select", "id": "ratio", "label": "Aspect ratio", "options": [ { "value": "56.25%", "label": "16:9" }, { "value": "42.85%", "label": "21:9" }, { "value": "100%", "label": "1:1" }, { "value": "125%", "label": "4:5" } ], "default": "56.25%" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "presets": [ { "name": "Video" } ]
}
{% endschema %}
