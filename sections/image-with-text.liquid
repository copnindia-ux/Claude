{%- assign s = section.settings -%}
<section class="color-{{ s.color_scheme }}" style="background: var(--gradient-background);">
  <div class="{% if s.full_width %}page-width--full{% else %}page-width section-padding{% endif %}" style="--pt: {{ s.padding_top }}; --pb: {{ s.padding_bottom }};">
    <div class="image-with-text{% if s.layout == 'right' %} image-with-text--reverse{% endif %}" style="--media-width: {{ s.media_width }}%; --content-v: {{ s.content_vertical }};">
      <div class="image-with-text__media">
        <div class="media" style="{% if s.image_height == 'adapt' and s.image != blank %}--media-ratio: {{ 1 | divided_by: s.image.aspect_ratio | times: 100 }}%;min-height:0;{% endif %}">
          {%- if s.video != blank -%}
            {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
          {%- elsif s.image != blank -%}
            {{ s.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '500, 800, 1200, 1600, 2000', sizes: '(min-width: 750px) 50vw, 100vw', alt: s.image.alt | escape }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
      <div class="image-with-text__content{% if s.text_align == 'center' %} image-with-text__content--center{% endif %}{% if settings.animations_enabled %} reveal{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'caption' -%}
              <p class="caption" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- when 'heading' -%}
              <h2 class="{{ block.settings.size }}" style="margin:0" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
            {%- when 'text' -%}
              <div class="rte" style="max-width:52rem" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'button' -%}
              {%- if block.settings.label != blank -%}
                <a href="{{ block.settings.link | default: '#' }}" class="button{% if block.settings.style == 'secondary' %} button--secondary{% elsif block.settings.style == 'link' %}-link{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
              {%- endif -%}
            {%- when 'product' -%}
              {%- if block.settings.product != blank -%}
                <div style="width:100%;max-width:36rem" {{ block.shopify_attributes }}>
                  {%- render 'product-card', product: block.settings.product, sizes: '360px' -%}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video", "info": "Overrides image." },
    { "type": "select", "id": "layout", "label": "Image position", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "range", "id": "media_width", "min": 30, "max": 70, "step": 5, "unit": "%", "label": "Image width", "default": 50 },
    { "type": "select", "id": "image_height", "label": "Image height", "options": [ { "value": "fill", "label": "Fill (min 320px)" }, { "value": "adapt", "label": "Adapt to image" } ], "default": "adapt" },
    { "type": "select", "id": "content_vertical", "label": "Content vertical alignment", "options": [ { "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "flex-end", "label": "Bottom" } ], "default": "center" },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "checkbox", "id": "full_width", "label": "Full width (edge to edge)", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding (contained)", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding (contained)", "default": 48 }
  ],
  "blocks": [
    { "type": "caption", "name": "Caption", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "our philosophy" } ] },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "fewer steps, better skin" },
        { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" } ], "default": "h1" }
      ]
    },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We make a short edit of hardworking essentials, so your routine stays simple and your skin stays happy.</p>" } ] },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "learn more" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "primary", "label": "Solid" }, { "value": "secondary", "label": "Outline" }, { "value": "link", "label": "Text link" } ], "default": "primary" }
      ]
    },
    { "type": "product", "name": "Product card", "limit": 1, "settings": [ { "type": "product", "id": "product", "label": "Product" } ] }
  ],
  "presets": [ { "name": "Image with text", "blocks": [ { "type": "caption" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ] } ]
}
{% endschema %}
