{%- liquid
  assign cols = ''
  for block in section.blocks
    case block.type
      when 'newsletter' or 'text'
        assign cols = cols | append: '2fr '
      else
        assign cols = cols | append: '1fr '
    endcase
  endfor
-%}
<footer class="site-footer color-{{ section.settings.color_scheme }} section-padding" style="--pt: {{ section.settings.padding_top }}; --pb: {{ section.settings.padding_bottom }};">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="site-footer__top" style="--footer-cols: {{ cols | strip }};">
        {%- for block in section.blocks -%}
          <div class="footer-block footer-block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="h2">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte" style="margin-bottom:1.6rem">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- render 'newsletter-form', id: 'FooterNewsletter', form_id: block.id -%}
                {%- if block.settings.show_social -%}
                  <div style="margin-top:2rem;margin-left:-1rem">{%- render 'social-icons' -%}</div>
                {%- endif -%}
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <ul class="footer-block__menu list-unstyled" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-block__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  <div style="max-width: {{ block.settings.width }}px">
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 800', alt: block.settings.image.alt }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <div class="site-footer__wordmark" aria-hidden="true">
        {%- if section.settings.wordmark_image != blank -%}
          {{ section.settings.wordmark_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1800, 2400', alt: '' }}
        {%- else -%}
          {{ section.settings.wordmark_text | default: shop.name | escape }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="site-footer__bottom">
      <div class="site-footer__policies">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>
        {%- if section.settings.show_policies -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.show_powered_by -%}<span>{{ powered_by_link }}</span>{%- endif -%}
      </div>
      {%- if section.settings.show_localization -%}
        {%- render 'localization-form', id: 'FooterLocalization' -%}
      {%- endif -%}
      {%- if section.settings.show_payment_icons -%}
        <ul class="payment-icons list-unstyled" role="list">
          <li class="visually-hidden">{{ 'sections.footer.payment' | t }}</li>
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon--payment' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show large wordmark", "default": true },
    { "type": "text", "id": "wordmark_text", "label": "Wordmark text", "info": "Defaults to the store name." },
    { "type": "image_picker", "id": "wordmark_image", "label": "Wordmark image", "info": "Replaces the text wordmark (use a wide SVG or PNG)." },
    { "type": "checkbox", "id": "show_localization", "label": "Show country/language selectors", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true },
    { "type": "checkbox", "id": "show_powered_by", "label": "Show 'Powered by Shopify'", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 24 }
  ],
  "blocks": [
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "join the list" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>early access to launches, restocks and routines worth trying.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "about" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share a few words about your brand.</p>" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "width", "min": 50, "max": 400, "step": 10, "unit": "px", "label": "Width", "default": 150 }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
