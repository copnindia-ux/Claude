<div class="customer">
  <div id="RecoverPassword" hidden>
    <h1 class="h1">{{ 'customer.recover_password.title' | t }}</h1>
    <p class="subtext text-center">{{ 'customer.recover_password.subtext' | t }}</p>
    {%- form 'recover_customer_password' -%}
      {%- assign recover_success = form.posted_successfully? -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
        <input class="input" type="email" id="RecoverEmail" name="email" autocomplete="email" autocapitalize="off" required>
      </div>
      <button class="button button--full">{{ 'customer.login_page.submit' | t }}</button>
      <div class="customer__links"><a href="#login" class="link-underline" data-toggle-recover>{{ 'customer.login_page.cancel' | t }}</a></div>
    {%- endform -%}
  </div>

  <div id="CustomerLogin">
    <h1 class="h1">{{ 'customer.login_page.title' | t }}</h1>
    {%- if recover_success -%}
      <p class="form-message form-message--success">{{ 'customer.recover_password.success' | t }}</p>
    {%- endif -%}
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
        <input class="input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocapitalize="off" required>
      </div>
      {%- if form.password_needed -%}
        <div class="field">
          <label for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
          <input class="input" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
        </div>
      {%- endif -%}
      <button class="button button--full">{{ 'customer.login_page.sign_in' | t }}</button>
      <div class="customer__links">
        {%- if form.password_needed -%}<a href="#recover" class="link-underline" data-toggle-recover>{{ 'customer.login_page.forgot_password' | t }}</a>{%- endif -%}
        <a href="{{ routes.account_register_url }}" class="link-underline">{{ 'customer.login_page.create_account' | t }}</a>
      </div>
    {%- endform -%}

    {%- if shop.checkout.guest_login -%}
      <hr>
      <h2 class="h3 text-center">{{ 'customer.login_page.guest_title' | t }}</h2>
      {%- form 'guest_login' -%}
        <button class="button button--secondary button--full">{{ 'customer.login_page.guest_continue' | t }}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    var login = document.getElementById('CustomerLogin');
    var recover = document.getElementById('RecoverPassword');
    function show(isRecover) { recover.hidden = !isRecover; login.hidden = isRecover; }
    if (window.location.hash === '#recover' || recover.querySelector('.form-message--error')) show(true);
    document.querySelectorAll('[data-toggle-recover]').forEach(function (el) {
      el.addEventListener('click', function (e) { e.preventDefault(); show(recover.hidden); });
    });
  })();
</script>
