<div class="customer customer--wide">
  <p><a href="{{ routes.account_url }}" class="link-underline">{{ 'customer.account.return' | t }}</a></p>
  <h1 class="h1" style="text-align:left">{{ 'customer.order.title' | t: name: order.name }}</h1>
  {%- assign order_date = order.created_at | time_tag: format: 'date_at_time' -%}
  <p class="subtext">{{ 'customer.order.date_html' | t: date: order_date }}</p>
  {%- if order.cancelled -%}
    <p class="form-message form-message--error">{%- assign cancelled_date = order.cancelled_at | time_tag: format: 'date_at_time' -%}{{ 'customer.order.cancelled_html' | t: date: cancelled_date }} &mdash; {{ order.cancel_reason_label }}</p>
  {%- endif -%}

  <div class="account-grid" style="margin-top:3.2rem">
    <div>
      <table class="order-table" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col">{{ 'customer.order.product' | t }}</th>
            <th scope="col">{{ 'customer.order.sku' | t }}</th>
            <th scope="col">{{ 'customer.order.price' | t }}</th>
            <th scope="col">{{ 'customer.order.quantity' | t }}</th>
            <th scope="col">{{ 'customer.order.total' | t }}</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {%- for line_item in order.line_items -%}
            <tr role="row">
              <td data-label="{{ 'customer.order.product' | t }}">
                {{ line_item.title | link_to: line_item.product.url }}
                {%- if line_item.fulfillment -%}
                  <div class="caption subtext">
                    {%- assign fulfilled_date = line_item.fulfillment.created_at | time_tag: format: 'date' -%}
                    {{ 'customer.order.fulfilled_at_html' | t: date: fulfilled_date }}
                    {%- if line_item.fulfillment.tracking_url -%} &middot; <a href="{{ line_item.fulfillment.tracking_url }}" class="link-underline">{{ 'customer.order.track_shipment' | t }}</a>{%- endif -%}
                  </div>
                {%- endif -%}
              </td>
              <td data-label="{{ 'customer.order.sku' | t }}">{{ line_item.sku }}</td>
              <td data-label="{{ 'customer.order.price' | t }}">{{ line_item.final_price | money }}</td>
              <td data-label="{{ 'customer.order.quantity' | t }}">{{ line_item.quantity }}</td>
              <td data-label="{{ 'customer.order.total' | t }}">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="4">{{ 'customer.order.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for discount in order.cart_level_discount_applications -%}
            <tr><td colspan="4">{{ 'customer.order.discount' | t }} ({{ discount.title }})</td><td>-{{ discount.total_allocated_amount | money }}</td></tr>
          {%- endfor -%}
          {%- for shipping_method in order.shipping_methods -%}
            <tr><td colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr><td colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td><td>{{ tax_line.price | money }}</td></tr>
          {%- endfor -%}
          <tr><td colspan="4"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_net_amount | money_with_currency }}</strong></td></tr>
        </tfoot>
      </table>
    </div>
    <div>
      <h2 class="h4">{{ 'customer.order.billing_address' | t }}</h2>
      <p class="subtext">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
      <div class="address-card" style="margin-bottom:2.4rem">{{ order.billing_address | format_address }}</div>
      <h2 class="h4">{{ 'customer.order.shipping_address' | t }}</h2>
      <p class="subtext">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
      <div class="address-card">{{ order.shipping_address | format_address }}</div>
    </div>
  </div>
</div>
